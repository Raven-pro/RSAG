        status: 401,
        headers: {
          "Content-Type": "application/json"
        }
      });
    }
    const payload = {
      username,
      role: username === "admin" ? "admin" : "editor",
      exp: Math.floor(Date.now() / 1e3) + 24 * 60 * 60
      // 24小时过期
    };
    const token = await generateJWT(payload, env.JWT_SECRET || "rsag-secret-key-2025");
