            SELECT id, title, summary, content, author, publish_date, featured_image, category, tags, status, created_at, updated_at
            FROM news
            WHERE id = ? AND status = 'published'
        `).bind(id).first();
    if (!news) {
      return createErrorResponse("\u65B0\u95FB\u4E0D\u5B58\u5728", 404);
    }
    return createResponse({ news });
  } catch (error) {
    console.error("\u83B7\u53D6\u516C\u5F00\u65B0\u95FB\u8BE6\u60C5\u5931\u8D25:", error);
    return createErrorResponse(error.message);
  }
}
